// Beta flavor — COMMITTED, used only by `.github/workflows/deploy-pre-release.yml`:
//
//     xcodebuild archive -xcconfig Config/Beta.xcconfig ...
//
// The beta installs as a separate app next to regular EhPanda, so everything that identifies an
// install differs: the bundle identifiers (`app.ehpanda.beta` and `app.ehpanda.beta.shareExtension`,
// through the suffix knob in `Signing.xcconfig`), the Home Screen name and the URL scheme. The icon
// is the regular one. Nothing here tells the code which build it is: the workflow stamps the
// `EHPDistributionChannel` key into the built app's Info.plist after the archive, and the install
// source reads that.
//
// Settings passed with `-xcconfig` apply to every target, Swift packages included, above the
// project's own files and below any `NAME=value` given on the command line.

BUNDLE_ID_SUFFIX = .beta
EHPANDA_DISPLAY_NAME = EhPanda Beta
EHPANDA_URL_SCHEME = ehpanda-beta
