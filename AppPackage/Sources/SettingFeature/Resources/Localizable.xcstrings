    "tag_filtering_threshold" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwellenwert für Tag-Filterung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag Filtering Threshold"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タグフィルタリングしきい値"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "태그 필터링 임계값"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标签筛选阈值"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標籤篩選閾值"
          }
        }
      }
    },
    "tag_filtering_threshold_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst Tags weich filtern, indem du sie mit negativem Gewicht zu „Meine Tags“ hinzufügst. Ergeben die Tags einer Galerie zusammen ein Gewicht unter diesem Wert, wird sie ausgeblendet. Der Schwellenwert kann zwischen 0 und -9999 liegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can soft filter tags by adding them to My Tags with a negative weight. If a gallery has tags that add up to a weight below this value, it is filtered from view. This threshold can be set between 0 and -9999."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "負の重み付きでマイタグに追加することでタグをソフトフィルタリングすることができます。もしあるギャラリーが持つタグの重み総和がこのしきい値より低ければ、そのギャラリーはフィルタリングされます。このしきい値はゼロから -9999 まで設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이너스 가중치로 My Tags에 추가하여 태그를 소프트 필터할 수 있어요. 갤러리 태그의 가중치 합이 이 값 미만이면 보기에서 필터링되어요. 이 임계값은 0과 -9999 사이에서 설정할 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以通过将标签加入“我的标签”并设置一个负权重来软筛选它们。如果一个画廊所有的标签权重之和低于设定值，此画廊将从列表中被筛除。这个值可以设定为 0 ~ -9999。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以透過將標籤以負數權重新增到「我的標籤」來軟篩選標籤。如果畫廊的標籤加起來的權重低於此值，則會被從列表中篩除，此閾值可以設定在 0 ~ -9999 之間。"
          }
        }
      }
    },
    "tag_watching_threshold" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwellenwert für Tag-Beobachtung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag Watching Threshold"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タグフォローのしきい値"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관심 태그 임계값"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标签关注阈值"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追蹤標籤閾值"
          }
        }
      }
    },
    "tag_watching_threshold_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kürzlich hochgeladene Galerien erscheinen unter „Beobachtet“, wenn sie mindestens einen beobachteten Tag mit positivem Gewicht haben und die Gewichte ihrer beobachteten Tags zusammen diesen Wert erreichen oder überschreiten. Der Schwellenwert kann zwischen 0 und 9999 liegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recently uploaded galleries will be included on the watched screen if they have at least one watched tag with positive weight, and the sum of weights on their watched tags adds up to this value or higher. This threshold can be set between 0 and 9999."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もしあるギャラリーは最近投稿されたもので、少なくとも一つの正の重みのフォロー中のタグを持っていて、フォロー中のタグの重み総和がこのしきい値と同じまたはより高ければ、そのギャラリーは「フォロー中」画面で表示されます。このしきい値はゼロから 9999 まで設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근에 업로드된 갤러리는 양수 가중치의 관심 태그가 최소 1개 있고 관심 태그의 가중치의 합이 이 값 이상이 될 경우 관심 태그 화면에 포함되어요. 이 임계값은 0과 9999 사이에서 설정할 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果一个最近上传的画廊至少有一个正权重的已关注标签，且已关注标签的权重之和达到或高于设定值，它就会被包含在“关注”里。这个值可以设定为 0 ~ 9999。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果最近上傳的畫廊至少有一個正權重的已追蹤標籤，且已追蹤標籤的權重總和達到或高於此數值，它就會出現在「追蹤中」頁面，此閾值可以設定在 0 ~ 9999 之間。"
          }
        }
      }
    },
