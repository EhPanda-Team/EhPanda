    "virtual_width_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermit kannst du die virtuelle Breite der Seite auf Mobilgeräten überschreiben. Normalerweise bestimmt dein Gerät sie automatisch anhand der DPI. Sinnvolle Werte bei %@ Vorschaubild-Skalierung liegen zwischen 640 und 1400."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allows you to override the virtual width of the site for mobile devices. This is normally determined automatically by your device based on its DPI. Sensible values at %@ thumbnail scale are between 640 and 1400."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モバイルデバイスの仮想幅をオーバーライドすることができます。一般的にはデバイスの DPI に基づいて自動的に決定されます。例えばサムネイルスケール係数が %@ の場合、640 ~ 1400 の幅が合理的です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모바일 장치의 사이트 가상 너비를 설정할 수 있어요. 일반적으로 DPI에 따라 장치에 의해 자동으로 결정되어요. %@ 썸네일 스케일의 추천 값은 640에서 1400 사이예요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许你覆写移动设备上网站的虚拟宽度，通常由设备根据 DPI 自动确定，%@ 缩略图比例下的合理值在 640 到 1400 之间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許你覆寫行動裝置網站的虛擬寬度。這通常由你的裝置根據其 DPI 自動確定。%@ 縮圖比例的合理值介於 640 和 1400 之間。"
          }
        }
      }
    },
