    "hah_region_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sieht so aus, als würdest du dich in **%1$@** befinden oder ein VPN in diesem Land verwenden. Bilder werden daher standardmäßig aus der H@H-Region **%2$@** geladen. Falls das nicht stimmt oder du aus irgendeinem Grund eine andere Region bevorzugst (etwa mit einem Split-Tunneling-VPN), kannst du unten die gewünschte Region auswählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You appear to be located in **%1$@**, or use a VPN located there, and will default to load images from the **%2$@** H@H Region. If this is incorrect, or you prefer using a different region for any reason (like if you are using a split tunneling VPN), select the desired region below."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**%1$@** に滞在している、またはその国の VPN を使用しているようです。画像は既定で **%2$@** の H@H リージョンから読み込まれます。もしこの結果が誤っている、または特別な事情でほかのリージョンを希望する場合（例えばスプリットトンネル VPN を使用している）は下に手動選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**%1$@**에 있거나 이 나라의 VPN을 사용하는 것 같네요. 기본적으로 **%2$@** H@H 지역에서 이미지를 로드할 거예요. 만약에 이 결과가 잘못되었거나 분할 터널링 VPN을 사용하는 경우와 같이 어떤 이유로든 다른 지역을 사용하려는 경우라면, 아래에서 원하는 지역을 선택할 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你似乎位于 **%1$@**，或是使用了一个来自这个国家的 VPN，网站将默认通过 **%2$@** H@H 区域加载图片。如果该结果不正确，或你出于任何原因想使用其它区域（例如你正在使用分割隧道 VPN），你可以在下方选择所需的区域。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你似乎位於 **%1$@**，或在使用當地的 VPN，網站將預設從 **%2$@** H@H 區域載入圖片。如果這不正確，或你出於任何原因想要使用不同的區域（例如你正在使用分割隧道 VPN），你可以在下方選擇所需的區域。"
          }
        }
      }
    },
