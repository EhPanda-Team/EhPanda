    "image_resolution_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder werden für die Online-Ansicht normalerweise auf eine horizontale Auflösung von 1280 Pixeln (Desktop) bzw. 800 Pixeln (Mobil) neu berechnet. Du kannst eine der folgenden alternativen Auflösungen wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images are normally resampled to 1280 pixels (desktop) or 800 pixels (mobile) horizontal resolution for online viewing. You can select one of the following alternative resolutions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一般的に、オンライン閲覧の画像は横 1280 ピクセル（デスクトップ）または 800 ピクセル（モバイル）にリサンプリングされます。下のいずれかの代替解像度に変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일반적으로 이미지는 온라인 뷰어를 위해 1280 픽셀(데스크톱) 또는 800 픽셀(모바일)의 수평 해상도로 작아져요. 아래의 대체 해상도 중 하나를 선택할 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常情况，图像将重采样到 1280 像素（桌面端）或 800 像素（移动端）宽度以用于在线浏览，你也可以选择以下替代分辨率之一。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一般情況下圖片會被重新取樣成 1280 px（桌面版）或 800 px（行動版）水平解析度以供線上瀏覽，你也可以選擇下列替代解析度之一。"
          }
        }
      }
    },
