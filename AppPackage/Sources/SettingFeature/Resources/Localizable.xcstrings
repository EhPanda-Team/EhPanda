    "network_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird immer nur eine Galerie heruntergeladen. Hier legst du fest, wie viele Seiten gleichzeitig geladen werden und ob Mobilfunk erlaubt ist. Die Dateien liegen im Downloads-Ordner der App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galleries download one at a time. Choose how many pages download at once and whether cellular data can be used. Files are saved in the app’s Downloads folder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ギャラリーは1件ずつダウンロードされます。ここでは、同時にダウンロードするページ数とモバイル通信の使用を設定できます。ファイルはアプリの「Downloads」フォルダに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "갤러리는 한 번에 하나씩 다운로드됩니다. 여기서 동시에 다운로드할 페이지 수와 모바일 데이터 다운로드 허용 여부를 설정합니다. 파일은 앱의 Downloads 폴더에 저장됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次只下载一个画廊。可设置同时下载的页数和是否允许使用移动网络。文件保存在应用的 Downloads 文件夹中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次只下載一個畫廊。可設定同時下載的頁數和是否允許使用行動網路。檔案儲存在 App 的 Downloads 資料夾中。"
          }
        }
      }
    },
