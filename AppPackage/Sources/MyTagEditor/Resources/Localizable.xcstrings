    "my_tags.state_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galerien mit beobachteten Tags erscheinen unter „Beobachtet“. Galerien mit ausgeblendeten Tags fehlen in den Listen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galleries with watched tags show up in Watched. Galleries with hidden tags are left out of lists."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォロー中のタグを含むギャラリーは「フォロー中」に表示され、非表示のタグを含むギャラリーは一覧に表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관심 태그가 붙은 갤러리는 ‘관심 태그’에 표시되고, 숨긴 태그가 붙은 갤러리는 목록에서 빠집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "含有关注标签的画廊会出现在“关注”中，含有隐藏标签的画廊不会出现在列表里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "含有追蹤標籤的畫廊會出現在「追蹤中」，含有隱藏標籤的畫廊不會出現在列表裡。"
          }
        }
      }
    },
