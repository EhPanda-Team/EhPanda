    "my_tags.weight_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gewichte der Tags einer Galerie werden addiert und mit den Schwellenwerten in den %@-Einstellungen verglichen. Möglich sind −99 bis 99."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gallery’s tag weights are added up and compared with the thresholds in %@ Settings. From −99 to 99."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ギャラリーのタグの重みは合計され、%@ 設定のしきい値と比べられます。−99〜99 で設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "갤러리에 붙은 태그의 가중치를 합산해 %@ 설정의 임계값과 비교합니다. −99부터 99까지 설정할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画廊各标签的权重会相加，再与“%@ 设置”中的阈值比较。可设为 −99 ~ 99。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "畫廊各標籤的權重會加總，再與「%@ 設定」中的閾值比較。可設定在 −99 ~ 99 之間。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}