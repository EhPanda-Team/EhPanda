    "consent.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonyme Analysedaten. Deine Suchen und die Galerien, die du ansiehst, werden nie gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonymous analytics. Your searches and the galleries you view are never sent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匿名の分析データです。検索語や閲覧したギャラリーは送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
