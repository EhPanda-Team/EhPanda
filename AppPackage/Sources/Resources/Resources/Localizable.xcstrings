        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私に適用されるすべての法律のもとで、私は成人であり、性的に露骨なコンテンツを閲覧できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저에게 적용되는 모든 법률에 따라 저는 성인이며 성적으로 노골적인 콘텐츠를 볼 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依据适用于我的所有法律，我已成年，且可浏览色情内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
