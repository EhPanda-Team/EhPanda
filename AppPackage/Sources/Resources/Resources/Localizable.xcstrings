    "age_wall.declaration" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach jedem für mich geltenden Recht bin ich volljährig und darf sexuell explizite Inhalte ansehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under every law that applies to me, I'm an adult and may view sexually explicit content."
