    "automatic_layout_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iPad and iPhone Duo, landscape shows two pages and portrait shows one, each in the direction selected above. Applies when you open the reader and when the orientation changes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf iPad und iPhone Duo werden im Querformat zwei Seiten und im Hochformat eine Seite in der gewählten Leserichtung angezeigt. Gilt beim Öffnen und beim Ändern der Bildschirmausrichtung."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPadとiPhone Duoでは、選択した方向で読み進め、横向きでは見開き、縦向きでは1ページで表示します。リーダーを開いたときと画面の向きが変わったときに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad와 iPhone Duo에서 선택한 읽기 방향을 사용하며, 가로 화면에서는 두 페이지, 세로 화면에서는 한 페이지를 표시합니다. 뷰어를 열거나 화면 방향을 바꾸면 적용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPad 和 iPhone Duo 上使用所选阅读方向，横屏显示双页，竖屏显示单页。打开阅读器及屏幕方向改变时自动应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPad 和 iPhone Duo 上使用所選閱讀方向，橫向顯示雙頁，直向顯示單頁。開啟閱讀器及螢幕方向改變時自動套用。"
          }
        }
      }
    },
