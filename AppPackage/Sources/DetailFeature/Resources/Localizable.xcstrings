    "report.failed.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your report wasn't sent. Try again, or report on %@'s page instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Meldung wurde nicht gesendet. Versuche es erneut oder melde es stattdessen auf der Seite von %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通報は送信されませんでした。もう一度お試しいただくか、%@ の通報ページをご利用ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신고가 전송되지 않았습니다. 다시 시도하거나 %@의 신고 페이지를 이용해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举报未发送。请重试，或改用 %@ 的举报页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢舉未傳送。請重試，或改用 %@ 的檢舉頁面。"
          }
        }
      }
    },
