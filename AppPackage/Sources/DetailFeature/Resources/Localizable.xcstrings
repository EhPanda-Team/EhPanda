          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請說明哪些內容違法，以及出現在哪些頁面。"
          }
        }
      }
    },
    "report.help.illegal_warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports that aren't about illegal content, including copyright requests, can get you banned from %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldungen, die keine illegalen Inhalte betreffen, auch Urheberrechtsanfragen, können dazu führen, dass du auf %@ gesperrt wirst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "違法コンテンツ以外の通報（著作権に関する申し立てを含む）を送ると、%@ の利用を停止されることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "불법 콘텐츠가 아닌 내용을 신고하면(저작권 요청 포함) %@ 이용이 제한될 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果举报的不是违法内容（包括版权请求），你可能会被 %@ 封禁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果檢舉的不是違法內容（包括著作權請求），你可能會被 %@ 停權。"
          }
        }
      }
    },
    "report.comment_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The comment is filled in for you, because %@'s reports cover the whole gallery. Add why you're reporting it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kommentar ist schon eingetragen, weil Meldungen auf %@ immer die ganze Galerie betreffen. Ergänze, warum du ihn meldest."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の通報はギャラリー全体が対象のため、コメントはあらかじめ入力されています。通報する理由を書き足してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 신고는 갤러리 전체를 대상으로 하므로 댓글이 미리 입력되어 있습니다. 신고하는 이유를 덧붙여 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于 %@ 的举报针对整个画廊，评论已帮你填好。请补充举报的原因。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於 %@ 的檢舉針對整個畫廊，留言已幫你填好。請補充檢舉的原因。"
          }
        }
      }
    },
