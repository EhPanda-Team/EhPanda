    "comment.report.confirm_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This opens the gallery's report page on %1$@, where the site's staff handle reports. Mention that it's about a comment by %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch öffnet sich die Meldeseite der Galerie auf %1$@, wo das Team der Seite Meldungen bearbeitet. Gib dort an, dass es um einen Kommentar von %2$@ geht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ のギャラリー通報ページが開きます。通報はサイトの運営チームが対応します。%2$@ さんのコメントについての通報であることを書き添えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@의 갤러리 신고 페이지가 열리며, 신고는 사이트 운영진이 처리합니다. %2$@ 님의 댓글에 대한 신고라고 적어 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将打开 %1$@ 上该画廊的举报页面，举报由网站管理人员处理。请注明举报的是 %2$@ 的评论。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將開啟 %1$@ 上這個畫廊的檢舉頁面，檢舉由網站管理人員處理。請註明檢舉的是 %2$@ 的留言。"
          }
        }
      }
    },
