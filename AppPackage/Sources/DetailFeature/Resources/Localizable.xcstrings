    "report.unavailable.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ may have changed its report page. You can still report there."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat die Meldeseite möglicherweise geändert. Du kannst dort trotzdem melden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の通報ページが変更された可能性があります。そのページからは引き続き通報できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 신고 페이지가 바뀌었을 수 있습니다. 해당 페이지에서는 계속 신고할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的举报页面可能已更改，你仍可以在那里举报。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的檢舉頁面可能已變更，你仍可以在那裡檢舉。"
          }
        }
      }
