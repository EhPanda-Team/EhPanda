    "report.help.illegal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe what's illegal and which pages it's on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe, was illegal ist und auf welchen Seiten es zu finden ist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何が違法なのか、どのページにあるのかを書いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇이 불법인지, 어느 페이지에 있는지 적어 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
