    "download_store.asset_unreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asset file is unreadable: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Asset-Datei ist nicht lesbar: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アセットファイルを読み取れません: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에셋 파일을 읽을 수 없습니다: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资源文件无法读取：%@"
