{
  "sourceLanguage": "en",
  "strings": {
    "favorites.empty.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stöbere in Start und Suche und füge Galerien, die dir gefallen, zu den Favoriten hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore Home and Search, and add the galleries you enjoy to Favorites."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ホーム」や「検索」でギャラリーを探して、気に入ったものをお気に入りに追加しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈과 검색을 둘러보고 마음에 드는 갤러리를 즐겨찾기에 추가해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去“主页”和“搜索”逛逛，把喜欢的画廊加入收藏吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到「主頁」和「搜尋」逛逛，把喜歡的畫廊加入收藏吧。"
          }
        }
      }
    },
    "favorites.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Favoriten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Favorites Yet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りはまだありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 즐겨찾기가 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有收藏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有收藏"
          }
        }
      }
    },
