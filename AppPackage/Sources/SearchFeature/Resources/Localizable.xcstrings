    "remove_searches_confirmation": {
      "comment": "Confirmation before removing every recent search keyword; saved Quick Search entries remain.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove all recent searches? Your saved searches will be kept."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle letzten Suchanfragen entfernen? Deine gespeicherten Suchanfragen bleiben erhalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近の検索をすべて削除しますか？保存した検索は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 검색 기록을 모두 삭제할까요? 저장된 검색은 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除所有最近搜索记录？已保存的快速搜索将会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除所有最近搜尋紀錄？已儲存的快速搜尋會保留。"
          }
        }
      }
    },
    "remove_seen_confirmation": {
      "comment": "Confirmation for removing all browsing history, matching the History screen; resume positions are stored on the same records.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove all browsing history and saved reading positions?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gesamten Browserverlauf und alle gespeicherten Lesepositionen entfernen?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閲覧履歴と保存された読書位置をすべて削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 탐색 기록과 저장된 읽기 위치를 삭제할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除全部浏览记录及已保存的阅读位置？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除全部瀏覽紀錄及已儲存的閱讀位置？"
          }
        }
      }
    },
