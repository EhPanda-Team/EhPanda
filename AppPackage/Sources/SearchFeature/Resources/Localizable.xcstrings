    "remove_searches_confirmation": {
      "comment": "Confirmation before removing every recent search keyword; saved Quick Search entries remain.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove all recent searches? Your saved searches will be kept."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gesamten Suchverlauf entfernen? Gespeicherte Suchbegriffe bleiben erhalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近の検索をすべて削除しますか？保存したキーワードは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 검색어를 모두 삭제할까요? 저장된 검색어는 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空最近搜索？已保存的关键词不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要移除所有最近的搜尋紀錄嗎？已儲存的快速搜尋會保留。"
          }
        }
      }
    },
    "remove_seen_confirmation": {
      "comment": "Confirmation for removing all browsing history, matching the History screen; resume positions are stored on the same records.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove all browsing history and saved reading positions?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gesamten Verlauf und alle gespeicherten Lesepositionen entfernen?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閲覧履歴と読書位置をすべて削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 본 갤러리와 저장된 읽기 위치를 모두 삭제할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空浏览记录及已保存的阅读位置？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要移除所有瀏覽紀錄及已儲存的閱讀位置嗎？"
          }
        }
      }
    },
