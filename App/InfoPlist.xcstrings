    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets you save images to your photo library."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird benötigt, um Bilder in deinen Fotos zu speichern."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を写真ライブラリに保存するために使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 사진 보관함에 저장하려면 이 권한이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要此权限才能将图片保存到相册。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "EhPanda 需要此權限才能將圖片儲存到「照片」。"
